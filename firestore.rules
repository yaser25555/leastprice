rules_version = '2';
service cloud.firestore {
  // IMPORTANT: daily_price_bot.py uses a Firebase service account
  // (Admin SDK), which BYPASSES security rules entirely. The bot can
  // write to all collections regardless of these rules.
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========

    function isAuth() {
      return request.auth != null;
    }

    function isPrimaryAdmin() {
      return isAuth()
        && request.auth.token.email == 'yaser.haroon79@gmail.com';
    }

    function isMarketingManager() {
      return isAuth()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.adminRole == 'marketing_manager';
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ========== PUBLIC CATALOG (read for all auth users) ==========

    // ========== PRODUCTS & BANNERS (primary admin only) ==========

    match /products/{document} {
      allow read: if isAuth();
      allow create, update, delete: if isPrimaryAdmin();
    }

    match /ad_banners/{document} {
      allow read: if isAuth();
      allow create, update, delete: if isPrimaryAdmin();
    }

    // ========== DEALS & COUPONS (primary admin + marketing manager) ==========

    match /exclusive_deals/{document} {
      allow read: if isAuth();
      allow create, update, delete: if isPrimaryAdmin() || isMarketingManager();
    }

    match /coupons/{document} {
      allow read: if isAuth();
      allow create, update, delete: if isPrimaryAdmin() || isMarketingManager();
    }

    // ========== SYSTEM HEALTH (primary admin only, bot writes via Admin SDK) ==========

    match /system_health/{document} {
      allow read: if isAuth();
      allow write: if isPrimaryAdmin();
    }

    // ========== APP CONFIG (public read, primary admin write) ==========

    match /config/{document} {
      allow read: if true;
      allow write: if isPrimaryAdmin();
    }

    // ========== USERS (own doc only, primary admin reads all) ==========

    match /users/{userId} {
      allow read: if isOwner(userId) || isPrimaryAdmin() || isMarketingManager();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isPrimaryAdmin();
      allow delete: if isPrimaryAdmin();
    }

    // ========== SEARCH CACHE (auth users manage own entries) ==========

    match /comparison_search_cache/{document} {
      allow read: if isAuth();
      allow create, update: if isAuth();
      allow delete: if isPrimaryAdmin();
    }

    // ========== USER SUBMISSIONS (any auth user can create) ==========

    match /barcode_feedback/{document} {
      allow create: if isAuth();
      allow read: if isPrimaryAdmin() || isMarketingManager();
      allow update, delete: if isPrimaryAdmin();
    }

    match /search_requests/{document} {
      allow create: if isAuth();
      allow read: if isPrimaryAdmin() || isMarketingManager();
      allow update, delete: if isPrimaryAdmin();
    }

    // ========== FAVORITES (users manage their own) ==========

    match /favorites/{document} {
      allow read: if isOwner(resource.data.userId);
      allow create, update: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.userId == request.auth.uid;
    }

    // ========== PRICE HISTORY (auth users read, bot creates via Admin SDK) ==========

    match /price_history/{document} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isPrimaryAdmin();
    }

    // ========== UNUSED (declared but never accessed from client code) ==========

    match /popular_products/{document} {
      allow read, write: if false;
    }
  }
}
