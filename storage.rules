rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Admin uploads (product images, banner images, deal images, etc.)
    // Read: anyone (public images displayed in the app)
    // Write: only users with adminRole == 'marketing_manager'
    match /admin_uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.adminRole == 'marketing_manager';
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
